rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // Colección de RATINGS
    // ========================================
    match /ratings/{ratingId} {
      // Permitir lectura a usuarios autenticados
      allow read: if request.auth != null;

      // Permitir crear rating si está autenticado
      // (No validamos usuarioId == auth.uid porque son diferentes sistemas)
      allow create: if request.auth != null;

      // Permitir actualizar si está autenticado
      allow update: if request.auth != null;

      // Permitir eliminar si está autenticado
      allow delete: if request.auth != null;
    }

    // ========================================
    // Colección de ASISTENCIAS
    // ========================================
    match /asistencias/{asistenciaId} {
      // Permitir lectura a usuarios autenticados
      allow read: if request.auth != null;

      // Permitir crear asistencia si está autenticado
      allow create: if request.auth != null &&
                      request.resource.data.firebaseUid == request.auth.uid;

      // Permitir actualizar si el firebaseUid coincide
      allow update: if request.auth != null &&
                      resource.data.firebaseUid == request.auth.uid &&
                      request.resource.data.firebaseUid == request.auth.uid;

      // Permitir eliminar si el firebaseUid coincide
      allow delete: if request.auth != null &&
                      resource.data.firebaseUid == request.auth.uid;
    }
  }
}
